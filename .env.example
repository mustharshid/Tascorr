# ============================================
# Environment Configuration Template for Tascorr
# Copy this file to .env and fill in your values
# ============================================

# Port on which the API server will run
PORT=5000

# MySQL Connection string
# For local development:
# DATABASE_URL="mysql://username:password@localhost:3306/tascorr_dev"
# For Plesk hosting, use your phpMyAdmin database credentials
DATABASE_URL="mysql://tascorr_user:password123@localhost:3306/tascorr_db"

# JWT Secret key for signing authorization tokens
# IMPORTANT: Generate a unique 256-bit key for production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-very-secure-random-256-bit-key-for-production"

# Application Environment (development, production)
NODE_ENV="development"

# CORS: Comma-separated list of allowed origins (used when NODE_ENV=production)
# Example: "https://yourdomain.com,https://www.yourdomain.com"
ALLOWED_ORIGINS="https://yourdomain.com"

# Global Superadmin seed credentials (used by prisma/seed.ts)
SUPERADMIN_EMAIL="admin@tascorr.com"
SUPERADMIN_PASSWORD="ChangeMeImmediately!123"
