# =======================================================
# .env.example – Copy this to .env and fill in the values
# =======================================================

# Port on which the Node.js API server will run.
# IMPORTANT: Must match the port configured in the Plesk Node.js wizard.
PORT=5005

# MySQL/MariaDB database connection string.
DATABASE_URL="mysql://username:password@localhost:3306/tascorr"

# JWT Secret – generate with:  openssl rand -base64 48
# NEVER use the placeholder in production.
JWT_SECRET="replace-with-a-very-secure-random-256-bit-key-for-production"

# Application environment: "development" | "production"
NODE_ENV="production"

# Comma-separated list of allowed CORS origins (used in production).
# Must include the exact URL users type into their browser (no trailing slash).
ALLOWED_ORIGINS="https://soft.thinksafe.mv"

# Google Gemini API key for AI text formatting assistant (obtain from Google AI Studio)
GEMINI_API_KEY=""
